{
  "name": "ippon-slides",
  "version": "0.1.7",
  "description": "1 枚 1 メッセージのスライドを Markdown から作る CLI。HTML 1 ファイルと PDF を出力",
  "keywords": [
    "slides",
    "presentation",
    "markdown",
    "cli",
    "pdf",
    "takahashi-method"
  ],
  "license": "MIT",
  "author": "tanahiro2010",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanahiro2010/ippon-slides.git"
  },
  "homepage": "https://github.com/tanahiro2010/ippon-slides#readme",
  "bugs": {
    "url": "https://github.com/tanahiro2010/ippon-slides/issues"
  },
  "type": "module",
  "bin": {
    "ippon": "bin/ippon.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "bin",
    "dist",
    "assets"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p src/client",
    "typecheck": "tsc && tsc -p src/client --noEmit",
    "test": "npm run build && node --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
